# Telegram bot
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_without_at
# Telegram id of the bot owner (Denis). Used to deliver flow previews from the
# constructor. The bot polls bot_preview_requests and sends drafts to this id.
BOT_OWNER_TELEGRAM_ID=0

# Supabase project. The bot uses the service_role key (bypasses RLS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role
SUPABASE_ANON_KEY=eyJ...anon

# Storage buckets (created by 0002_storage.sql)
STORAGE_BUCKET_OUTFITS=outfit-images
STORAGE_BUCKET_COURSES=course-files
STORAGE_BUCKET_PDFS=outfit-pdfs

# Branding / URLs
PUBLIC_WEB_URL=https://marina-ptohobot-9rip.vercel.app
BOOKING_URL=https://zaugolnikova.ru/
FOOTER_BRAND_URL=https://malinacode.is-a.dev
BRAND_NAME=Marina Photo

# NOTE: Admin/mama passwords + JWT secret now live ONLY on the
# Supabase Edge Function (admin-login). Set them via:
#   supabase secrets set APP_ADMIN_PASSWORD=... APP_MAMA_PASSWORD=... APP_JWT_SECRET=...
# Frontend pages call the Edge Function directly; the bot never sees these.
