# Telegram bot
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_without_at
# Telegram id of the bot owner (Denis). Used to deliver flow previews from the constructor.
BOT_OWNER_TELEGRAM_ID=0

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role
SUPABASE_ANON_KEY=eyJ...anon

# Storage buckets (created by 0002_storage.sql)
STORAGE_BUCKET_OUTFITS=outfit-images
STORAGE_BUCKET_COURSES=course-files
STORAGE_BUCKET_PDFS=outfit-pdfs

# Branding / URLs
PUBLIC_WEB_URL=https://marinazau.denchy.cyou
BOOKING_URL=https://zaugolnikova.ru/
FOOTER_BRAND_URL=https://malinacode.is-a.dev
BRAND_NAME=Marina Photo

# Two-role admin auth - no emails. Use long random strings.
ADMIN_PASSWORD=change-me-admin
MAMA_PASSWORD=change-me-mama
JWT_SECRET=generate_a_long_random_secret_at_least_32_chars
JWT_TTL_HOURS=24

# Comma-separated CORS allowlist
CORS_ORIGINS=http://localhost:5173,https://marinazau.denchy.cyou

# Optional: API listen address
API_HOST=0.0.0.0
API_PORT=8000
